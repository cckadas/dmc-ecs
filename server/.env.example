# Copy this file to .env and fill it in (see README.md). Never commit .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLIENT_URL=http://localhost:5173
PORT=5000

# Emailing suppliers their purchase orders and payment proofs
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# The customer's order assistant
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=

# off stops the staff alerts about late orders and deliveries
# PREDICTION_ALERTS=off
